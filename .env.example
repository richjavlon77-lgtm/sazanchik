# ── База данных (Neon Postgres) ─────────────────────────────────
# Пулированное соединение — все обычные запросы
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"
# Прямое (непулированное) — только для SSE LISTEN/NOTIFY (доска официанта)
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db?sslmode=require"

# ── Аутентификация ──────────────────────────────────────────────
# Подписывает JWT-сессии и HMAC-токены QR-столов. 32+ случайных байта:
#   openssl rand -hex 32
SESSION_SECRET="replace-me"
# Пароль менеджера для /admin/login
ADMIN_PASSWORD="replace-me"

# ── Telegram-уведомления (заказы, вызовы, брони, ошибки) ────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Файлы (фото блюд) ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Прочее ──────────────────────────────────────────────────────
# Публичный адрес сайта (QR-ссылки, SEO, sitemap)
NEXT_PUBLIC_SITE_URL="https://sazanchik.vercel.app"
# Строгий QR-режим: 1 — заказ/вызов только с подписанным токеном стола
REQUIRE_TABLE_TOKEN="0"
# Для scripts/print-pdf.mjs: адрес запущенного сервера
# BASE_URL="http://localhost:3000"
