# ── База данных (Neon Postgres) ─────────────────────────────────
# Пулированное соединение — все обычные запросы
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"
# Прямое (непулированное) — только для SSE LISTEN/NOTIFY (доска официанта)
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db?sslmode=require"

# ── Аутентификация ──────────────────────────────────────────────
# Подписывает JWT-сессии и HMAC-токены QR-столов. 32+ случайных байта:
#   openssl rand -hex 32
SESSION_SECRET="replace-me"
# Подпись QR-кодов столов. ВАЖНО: печатные карточки привязаны к этому
# ключу — не менять после печати тиража! (фолбэк: SESSION_SECRET)
TABLE_QR_SECRET="replace-me-and-never-rotate"
# Пароль менеджера для /admin/login
ADMIN_PASSWORD="replace-me"

# ── Telegram: уведомления + бот @Sazanchik_city_bot ─────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Секрет вебхука бота (scripts/telegram-setup.mjs ставит его в setWebhook)
TELEGRAM_WEBHOOK_SECRET=""
# Одноразовый код привязки владельца: /start owner_<код>
TG_OWNER_CODE=""

# ── Файлы (фото блюд) ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Онлайн-оплата (выключена пока нет мерчант-аккаунтов) ────────
# Payme (Paycom Merchant API). Callback: POST /api/payments/payme
PAYME_MERCHANT_ID=""
PAYME_KEY=""
# Click SHOP-API. Callback (prepare+complete): POST /api/payments/click
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# ── Sentry (опционально — без DSN интеграция выключена) ────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Для заливки сорсмапов при сборке (CI/Vercel):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── Прочее ──────────────────────────────────────────────────────
# Публичный адрес сайта (QR-ссылки, SEO, sitemap)
NEXT_PUBLIC_SITE_URL="https://sazanchik.vercel.app"
# Строгий QR-режим: 1 — заказ/вызов только с подписанным токеном стола
REQUIRE_TABLE_TOKEN="0"
# Для scripts/print-pdf.mjs: адрес запущенного сервера
# BASE_URL="http://localhost:3000"
